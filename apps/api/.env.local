# Firecrawl Local Free Mode - No API keys, no Docker, no limits
# Copy this to .env or use: cp .env.local .env

# === Core Settings ===
PORT=3002
HOST=0.0.0.0
ENV=local

# === DISABLE ALL AUTHENTICATION & BILLING ===
USE_DB_AUTHENTICATION=false

# === Local Redis (installed via apt/brew) ===
REDIS_URL=redis://localhost:6379
REDIS_RATE_LIMIT_URL=redis://localhost:6379

# === Local PostgreSQL (for job queue) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=firecrawl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# === Local RabbitMQ ===
NUQ_RABBITMQ_URL=amqp://localhost:5672

# === Workers ===
NUM_WORKERS_PER_QUEUE=4
NUQ_WORKER_COUNT=2

# === Logging ===
LOGGING_LEVEL=INFO

# === Bull Board Admin (local only) ===
BULL_AUTH_KEY=local

# === Optional: Add your OpenAI key for LLM features (extract, etc.) ===
# OPENAI_API_KEY=sk-your-key-here

# === Optional: Ollama for free local LLM ===
# OLLAMA_BASE_URL=http://localhost:11434
